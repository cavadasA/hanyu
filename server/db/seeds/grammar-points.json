    "items": [
      "不、没（有）、不要"
    ],
    "order_idx": 17,
    "pattern": "不 + Verb/Adjective",
    "explanation": "Place 不 (bù) before a verb or adjective to negate it. Note: 有 (yǒu) uses 没 (méi) for negation instead.",
    "examples": [
      {
        "zh": "我不喝咖啡。",
        "pinyin": "Wǒ bù hē kāfēi.",
        "en": "I don't drink coffee."
      },
      {
        "zh": "她不是老师。",
        "pinyin": "Tā bú shì lǎoshī.",
        "en": "She is not a teacher."
      },
      {
        "zh": "我没有钱。",
        "pinyin": "Wǒ méiyǒu qián.",
        "en": "I don't have money."
      }
    ]
