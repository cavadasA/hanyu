    "order_idx": 23,
    "pattern": "Statement + 吗?",
    "explanation": "To turn a statement into a yes/no question, add 吗 (ma) at the end. The word order stays the same.",
    "examples": [
      {
        "zh": "你好吗？",
        "pinyin": "Nǐ hǎo ma?",
        "en": "How are you?"
      },
      {
        "zh": "你是学生吗？",
        "pinyin": "Nǐ shì xuéshēng ma?",
        "en": "Are you a student?"
      },
      {
        "zh": "他喜欢中国吗？",
        "pinyin": "Tā xǐhuān Zhōngguó ma?",
        "en": "Does he like China?"
      }
    ]
