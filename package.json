{
  "name": "hanyu",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w @hanyu/web",
    "dev:mobile": "npm run start -w @hanyu/mobile",
    "dev:server": "cd server && node --watch app.js",
    "build": "npm run build -w @hanyu/web",
    "gen:types": "supabase gen types typescript --linked > packages/data/src/database.types.ts",
    "supabase:link": "echo \"ERROR: El enlace a proyectos remotos se realiza en el runner de GitHub Actions para evitar colisiones entre organizaciones locales.\" && exit 1",
    "supabase:push": "echo \"ERROR: Las migraciones remotas se aplican exclusivamente mediante GitHub Actions para evitar contaminar entornos de otras organizaciones. Haz commit y push a main o usa workflow_dispatch.\" && exit 1",
    "supabase:deploy-functions": "npx supabase functions deploy",
    "build-readings": "node scripts/build-readings.js",
    "build-exercises": "node scripts/build-exercises.js",
    "build:supabase-seed": "node scripts/build-supabase-seed.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "import-hsk": "node scripts/import-hsk-data.js",
    "fetch-syllabus": "node scripts/fetch-syllabus.js",
    "import-syllabus": "node scripts/import-syllabus.js",
    "coverage": "node scripts/coverage-report.js",
    "start": "node server/app.js",
    "test": "node scripts/verify.js",
    "test:web": "vitest run",
    "test:mobile": "npm run test -w @hanyu/mobile",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @hanyu/domain && npm run typecheck -w @hanyu/data && npm run typecheck -w @hanyu/mobile"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "zustand": "^5.0.0"
  }
}
