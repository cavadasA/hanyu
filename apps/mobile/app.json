{
  "expo": {
    "name": "Hanyu",
    "slug": "hanyu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hanyu",
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hanyu usa el micrófono para comprobar si se te entiende al pronunciar en chino.",
          "speechRecognitionPermission": "Hanyu usa el reconocimiento de voz para comprobar si se te entiende al pronunciar en chino.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hanyu.app"
    },
    "android": {
      "package": "com.hanyu.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBFDFC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
